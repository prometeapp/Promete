<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Nullable>Enable</Nullable>
        <LangVersion>14</LangVersion>
        <NoWarn>CS1591</NoWarn>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Promete</PackageId>
        <Version>2.0.0-beta.7</Version>
        <PackageTags>Game Engine;2D;gamedev;games;gaming;windowing;OpenGL</PackageTags>
        <Description>A 2D-specified, lightweight, extensible and easy-to-use game engine.
        </Description>
        <Authors>Ebise Lutica</Authors>
        <Copyright>(C)2024-2026 Promete Developers</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://promete.app</PackageProjectUrl>
        <RepositoryUrl>https://github.com/prometeapp/Promete</RepositoryUrl>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Promete.Test" />
    </ItemGroup>

    <ItemGroup>
        <!-- ソースジェネレータと、その設定を利用者のコンパイルへ届ける -->
        <None
            Include="../Promete.SceneGen/bin/$(Configuration)/netstandard2.0/Promete.SceneGen.dll"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false"
        />
        <None Include="build/Promete.props" Pack="true" PackagePath="build" Visible="false" />
        <None
            Include="build/Promete.props"
            Pack="true"
            PackagePath="buildTransitive"
            Visible="false"
        />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\shaders\*.vert" />
        <EmbeddedResource Include="Resources\shaders\*.frag" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FreeTypeSharp" Version="3.1.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
        <PackageReference Include="NVorbis" Version="0.10.5" />
        <!-- Silk.NET フォーク（net10.0 専用）。メタパッケージは廃止したので
             使うサブシステムだけを明示的に参照する。 -->
        <PackageReference Include="Promete.Silk.Windowing" Version="2.23.0-prmt.1.0.0" />
        <PackageReference Include="Promete.Silk.Input" Version="2.23.0-prmt.1.0.0" />
        <PackageReference Include="Promete.Silk.OpenGL" Version="2.23.0-prmt.1.0.0" />
        <PackageReference Include="Promete.Silk.OpenAL" Version="2.23.0-prmt.1.0.0" />
        <PackageReference Include="Promete.Silk.Maths" Version="2.23.0-prmt.1.0.0" />
        <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Windowing\GLDesktop\" />
    </ItemGroup>
</Project>
