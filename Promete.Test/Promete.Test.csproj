<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>

        <!-- dotnet test ではエントリアセンブリがテストホストになり、
             DependencyContext.Default がテストアセンブリを記述しない。そのため Silk は
             runtimes/<rid>/native からネイティブを解決できない。RID を指定して出力直下へ
             平坦化し、Silk の BaseDirectoryResolver に拾わせる。 -->
        <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="8.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="FluentAssertions" Version="8.9.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Promete\Promete.csproj" />
        <!-- アセットパッケージのラウンドトリップのテストで、ライターを使う -->
        <ProjectReference Include="..\Promete.AssetPacker\Promete.AssetPacker.csproj" />
    </ItemGroup>

    <!-- アナライザーのテスト用に SceneGen をライブラリとして参照する。プロジェクト参照は
         Directory.Build.props がアナライザーとして追加済みで、ビルド順もそれで保証される。 -->
    <ItemGroup>
        <Reference Include="Promete.SceneGen">
            <HintPath>../Promete.SceneGen/bin/$(Configuration)/netstandard2.0/Promete.SceneGen.dll</HintPath>
        </Reference>
    </ItemGroup>

    <!-- EmbeddedResourceAssetSource のテスト用。論理パスは LogicalName で / 区切りにする -->
    <ItemGroup>
        <EmbeddedResource Include="assets\embedded\hello.txt" LogicalName="embedded/hello.txt" />
        <EmbeddedResource
            Include="assets\embedded\sub\nested.txt"
            LogicalName="embedded/sub/nested.txt"
        />
        <EmbeddedResource Include="assets\embedded\Upper.txt" LogicalName="embedded/Upper.txt" />
        <EmbeddedResource
            Include="assets\embedded-other\ignored.txt"
            LogicalName="other/ignored.txt"
        />
    </ItemGroup>

    <!-- PackageAssetSource の互換性のテスト用。形式 1.0 で書いたパッケージを、ファイルと埋め込みリソースの両方から読む -->
    <ItemGroup>
        <EmbeddedResource
            Include="assets\package-format\golden-v1.0.pak"
            LogicalName="package-format/golden-v1.0.pak"
        />
    </ItemGroup>

    <ItemGroup>
        <None Update="assets\**\*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
