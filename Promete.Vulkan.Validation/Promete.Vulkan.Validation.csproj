<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <PackageId>Promete.Vulkan.Validation</PackageId>
        <Version>2.3.0</Version>
        <PackageTags>Game Engine;2D;gamedev;games;gaming;Vulkan;validation</PackageTags>
        <Description>Vulkan validation layer plugin for Promete. For development use only.</Description>
        <Authors>Ebise Lutica</Authors>
        <Copyright>(C)2024-2026 Promete Developers</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://promete.app</PackageProjectUrl>
        <RepositoryUrl>https://github.com/prometeapp/Promete</RepositoryUrl>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference
            Include="Promete.Silk.Vulkan.Extensions.EXT"
            Version="2.23.0-prmt.1.0.0"
        />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
        <None Include="../assets/logo.png" Pack="true" PackagePath="icon.png" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Promete\Promete.csproj" />
    </ItemGroup>
</Project>
