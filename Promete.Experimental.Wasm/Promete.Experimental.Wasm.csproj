<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <WasmBuildNative>true</WasmBuildNative>
        <!-- GL コンテキスト生成と関数ポインタ解決のため WebGL2 (GLES3) を有効にする -->
        <EmccExtraLDFlags>-lGL -sMIN_WEBGL_VERSION=2 -sMAX_WEBGL_VERSION=2 -sFULL_ES3=1 -sGL_ENABLE_GET_PROC_ADDRESS=1 -sALLOW_TABLE_GROWTH=1</EmccExtraLDFlags>
        <!-- Promete 本体 (Vulkan や Windowing も含む) まで AOT すると重いので、PoC ではインタプリタで動かす -->
        <RunAOTCompilation>false</RunAOTCompilation>
        <!-- Promete.Example は自己完結型ではない実行可能プロジェクト。ライブラリとして参照するので検証を無効にする (NETSDK1150) -->
        <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
        <CalliSignatureOutDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)$(BaseIntermediateOutputPath)calli-signatures'))</CalliSignatureOutDir>
        <CalliSignatureToolDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools'))</CalliSignatureToolDir>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Promete\Promete.csproj" />
        <ProjectReference Include="..\Promete.Example\Promete.Example.csproj" />
        <NativeFileReference Include="gl_shim.c" />
        <!-- 生成物は Exec で作る。AOT の publish は内部で別ビルドを走らせ、そこでは下のターゲットが
             実行されないので、生成物のパスは固定して、ターゲットの外で宣言する。 -->
        <Compile Include="$(CalliSignatureOutDir)/CalliSignatures.g.cs" />
        <NativeFileReference Include="$(CalliSignatureOutDir)/calli_signatures.g.c" />
    </ItemGroup>

    <!-- Mono WASM は、calli でネイティブ関数ポインタを呼ぶためのスタブをシグネチャごとにビルド時に作る。
         Silk.NET の calli は自動では拾われないので、IL から集めて登録用の P/Invoke と C 関数を生成する。 -->
    <Target
        Name="GenerateCalliSignatures"
        BeforeTargets="CoreCompile"
        DependsOnTargets="ResolveReferences"
    >
        <ItemGroup>
            <_CalliSignatureAssembly
                Include="@(ReferencePath)"
                Condition="'%(Filename)' == 'Silk.NET.OpenGL'"
            />
        </ItemGroup>
        <!-- dotnet run の file-based app は、csproj のあるディレクトリから実行すると終わらなくなるので、
             作業ディレクトリを tools に固定する。 -->
        <Exec
            Command="dotnet run gen-calli-signatures.cs -- --out &quot;$(CalliSignatureOutDir)&quot; --library gl_shim --namespace Generated @(_CalliSignatureAssembly->'&quot;%(FullPath)&quot;', ' ')"
            WorkingDirectory="$(CalliSignatureToolDir)"
            Timeout="120000"
            StandardOutputImportance="high"
        />
    </Target>

    <!-- アセットは、ページが fetch して仮想ファイルシステム (/assets) に書き込む。publish 先の wwwroot/assets に、
         Promete.Example のアセットを丸ごとコピーし、一覧 (manifest.txt) を作る。 -->
    <Target Name="CopyPocAssets" AfterTargets="Publish">
        <ItemGroup>
            <_PocAsset Include="$(MSBuildThisFileDirectory)../Promete.Example/assets/*.png" />
            <_PocAsset Include="$(MSBuildThisFileDirectory)../Promete.Example/assets/*.ttf" />
            <_PocAsset Include="$(MSBuildThisFileDirectory)../Promete.Example/assets/*.wav" />
            <_PocAsset Include="$(MSBuildThisFileDirectory)../Promete.Example/assets/*.ogg" />
        </ItemGroup>
        <Copy
            SourceFiles="@(_PocAsset)"
            DestinationFolder="$(PublishDir)wwwroot/assets"
            SkipUnchangedFiles="true"
        />
        <WriteLinesToFile
            File="$(PublishDir)wwwroot/assets/manifest.txt"
            Lines="@(_PocAsset->'%(Filename)%(Extension)')"
            Overwrite="true"
        />
    </Target>
</Project>
