<Project>
    <!-- Promete.Web を使うアプリのビルド設定。パッケージでは buildTransitive に入る。リポジトリ内のアプリは、このファイルを手で Import する。 -->

    <PropertyGroup>
        <_PrometeWebRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</_PrometeWebRoot>
    </PropertyGroup>

    <ItemGroup>
        <!-- WebGL2 のコンテキスト生成と GL 関数の解決 -->
        <NativeFileReference Include="$(_PrometeWebRoot)/native/promete_web.c" />
        <!-- Silk.NET の calli のシグネチャを、Mono WASM の interp-to-native 表に載せる -->
        <NativeFileReference Include="$(_PrometeWebRoot)/Generated/calli_signatures.g.c" />
    </ItemGroup>

    <!--
        P/Invoke の表を作るときに、ブラウザでは使わないアセンブリを走査の対象から外す。
        Promete はデスクトップ向けに Silk.NET.SDL を参照している。トリミングしないビルド (Debug など) では、
        SDL の P/Invoke のコールバック (GameControllerButtonBind を返すもの) を ManagedToNativeGenerator が扱えずに失敗する。
        アセンブリ自体は配布物に残るが、ブラウザでは呼ばれないので読み込まれない。
    -->
    <ItemGroup>
        <PrometeWebPInvokeScanExclude Include="Silk.NET.SDL" />
    </ItemGroup>

    <Target Name="_PrometeExcludeFromPInvokeScan" BeforeTargets="_GenerateManagedToNative">
        <ItemGroup>
            <_PrometeExcludeByName
                Include="@(PrometeWebPInvokeScanExclude)"
                AsmName="%(Identity)"
            />
            <_PrometeScannedAssembly Include="@(_WasmAssembliesInternal)" AsmName="%(Filename)" />
            <_PrometeScannedAssembly Remove="@(_PrometeExcludeByName)" MatchOnMetadata="AsmName" />
            <_PrometeExcludedAssembly
                Include="@(_WasmAssembliesInternal)"
                Exclude="@(_PrometeScannedAssembly)"
            />
            <_WasmAssembliesInternal Remove="@(_PrometeExcludedAssembly)" />
        </ItemGroup>
    </Target>

    <Target Name="_PrometeRestorePInvokeScan" AfterTargets="_GenerateManagedToNative">
        <ItemGroup>
            <_WasmAssembliesInternal Include="@(_PrometeExcludedAssembly)" />
        </ItemGroup>
    </Target>

    <!--
        アセットのプリロード。
        <PrometeAsset Include="assets/**" /> の既定値 (TargetPath、Package) と正規化は、コアの Promete.targets が決める。
        ここでは評価時に PrometeAsset を触らない (このファイルはコアの targets より先に読み込まれる)。
        仮想ファイルシステム上のパスは TargetPath で、Load("assets/x.png") のような同期 API からそのまま読める。
    -->
    <PropertyGroup>
        <!-- SDK はこのプロパティに追記するので、先に足しておいても残る -->
        <ResolveStaticWebAssetsInputsDependsOn>$(ResolveStaticWebAssetsInputsDependsOn);_PrometeDefineAssets</ResolveStaticWebAssetsInputsDependsOn>
    </PropertyGroup>

    <!--
        アセットと、取得するアセットの一覧 (promete-assets.json)、既定の index.html / main.js を、静的 Web アセットとして登録する。
        プロジェクトの外にあるファイルは Content からは拾われないので、DefineStaticWebAssets で直接登録する。
    -->
    <!--
        契約の item (PrometeAssetFile) から promete-assets.json を書き、アセットを静的 Web アセットとして登録する。
        PrometeResolveAssets (正規化) と PrometePackAssets (パッケージ) が終わってから行う。
        パッケージが無くても、空の一覧のマニフェストを必ず書く (promete.js と C# のローダーが読むため)。
    -->
    <Target Name="_PrometeDefineAssets" DependsOnTargets="PrometeResolveAssets;PrometePackAssets">
        <!-- このファイルは SDK の targets より先に読み込まれるので、中間ディレクトリはターゲットの中で決める -->
        <PropertyGroup>
            <_PrometeAssetDir>$(ProjectDir)$(IntermediateOutputPath)promete\</_PrometeAssetDir>
            <_PrometeAssetManifest>$(_PrometeAssetDir)$(PrometeWebAssetManifestName)</_PrometeAssetManifest>
        </PropertyGroup>

        <!-- 種類ごとに分ける。種類の名前 (File / Package / EmbeddedPackage) はコアの契約 -->
        <ItemGroup>
            <_PrometeWebFile
                Include="@(PrometeAssetFile)"
                Condition="'%(PrometeAssetFile.PrometeAssetKind)' == 'File'"
            />
            <_PrometeWebPackage
                Include="@(PrometeAssetFile)"
                Condition="'%(PrometeAssetFile.PrometeAssetKind)' == 'Package'"
            />
            <_PrometeWebEmbeddedPackage
                Include="@(PrometeAssetFile)"
                Condition="'%(PrometeAssetFile.PrometeAssetKind)' == 'EmbeddedPackage'"
            />
        </ItemGroup>

        <!-- JSON 用に論理パスをエスケープする (\ と " は本来ファイル名に使えないが、念のため) -->
        <ItemGroup>
            <_PrometeWebFile Update="@(_PrometeWebFile)">
                <JsonPath>$([System.String]::Copy('%(_PrometeWebFile.LogicalPath)').Replace('\', '\\').Replace('&quot;', '\&quot;'))</JsonPath>
            </_PrometeWebFile>
        </ItemGroup>

        <!-- フォントは kind を font にする (拡張子は大文字・小文字を区別しない) -->
        <ItemGroup>
            <_PrometeWebFont
                Include="@(_PrometeWebFile)"
                Condition="$([System.IO.Path]::GetExtension('%(_PrometeWebFile.LogicalPath)').ToLowerInvariant()) == '.ttf' or $([System.IO.Path]::GetExtension('%(_PrometeWebFile.LogicalPath)').ToLowerInvariant()) == '.otf' or $([System.IO.Path]::GetExtension('%(_PrometeWebFile.LogicalPath)').ToLowerInvariant()) == '.woff' or $([System.IO.Path]::GetExtension('%(_PrometeWebFile.LogicalPath)').ToLowerInvariant()) == '.woff2'"
            />
            <_PrometeWebPlainFile
                Include="@(_PrometeWebFile)"
                Condition="$([System.IO.Path]::GetExtension('%(_PrometeWebFile.LogicalPath)').ToLowerInvariant()) != '.ttf' and $([System.IO.Path]::GetExtension('%(_PrometeWebFile.LogicalPath)').ToLowerInvariant()) != '.otf' and $([System.IO.Path]::GetExtension('%(_PrometeWebFile.LogicalPath)').ToLowerInvariant()) != '.woff' and $([System.IO.Path]::GetExtension('%(_PrometeWebFile.LogicalPath)').ToLowerInvariant()) != '.woff2'"
            />
        </ItemGroup>

        <!-- マニフェストの entries。形式は Promete.Web/Assets/WebAssetManifest.cs と promete.js の契約 (version 1) -->
        <ItemGroup>
            <_PrometeWebEntry Include="@(_PrometeWebFont->'{&quot;kind&quot;:&quot;font&quot;,&quot;path&quot;:&quot;/%(JsonPath)&quot;,&quot;url&quot;:&quot;%(JsonPath)&quot;,&quot;logicalPath&quot;:&quot;%(JsonPath)&quot;}')" />
            <_PrometeWebEntry Include="@(_PrometeWebPlainFile->'{&quot;kind&quot;:&quot;file&quot;,&quot;path&quot;:&quot;/%(JsonPath)&quot;,&quot;url&quot;:&quot;%(JsonPath)&quot;,&quot;logicalPath&quot;:&quot;%(JsonPath)&quot;}')" />
            <_PrometeWebEntry Include="@(_PrometeWebPackage->'{&quot;kind&quot;:&quot;package&quot;,&quot;path&quot;:&quot;/%(Location)&quot;,&quot;url&quot;:&quot;%(Location)&quot;,&quot;package&quot;:&quot;%(PackageName)&quot;}')" />
            <_PrometeWebEntry Include="@(_PrometeWebEmbeddedPackage->'{&quot;kind&quot;:&quot;embedded-package&quot;,&quot;assembly&quot;:&quot;$(AssemblyName)&quot;,&quot;resource&quot;:&quot;%(Location)&quot;,&quot;package&quot;:&quot;%(PackageName)&quot;}')" />
        </ItemGroup>

        <WriteLinesToFile
            File="$(_PrometeAssetManifest)"
            Lines="{&quot;version&quot;:1,&quot;entries&quot;:[;@(_PrometeWebEntry, ',');]}"
            Overwrite="true"
            WriteOnlyWhenDifferent="true"
        />

        <ItemGroup>
            <FileWrites Include="$(_PrometeAssetManifest)" />
            <!-- 実ファイルは、論理パスの位置で配る (Folder と Package のファイル本体は、ここで静的 Web アセットになる) -->
            <_PrometeAssetCandidate Include="@(_PrometeWebFile->'%(FullPath)')">
                <RelativePath>%(_PrometeWebFile.LogicalPath)</RelativePath>
                <ContentRoot>%(_PrometeWebFile.RootDir)%(_PrometeWebFile.Directory)</ContentRoot>
            </_PrometeAssetCandidate>
            <_PrometeAssetCandidate Include="@(_PrometeWebPackage->'%(FullPath)')">
                <RelativePath>%(_PrometeWebPackage.Location)</RelativePath>
                <ContentRoot>%(_PrometeWebPackage.RootDir)%(_PrometeWebPackage.Directory)</ContentRoot>
            </_PrometeAssetCandidate>
            <_PrometeAssetCandidate Include="$(_PrometeAssetManifest)">
                <RelativePath>$(PrometeWebAssetManifestName)</RelativePath>
                <ContentRoot>$(_PrometeAssetDir)</ContentRoot>
            </_PrometeAssetCandidate>

            <!--
                既定の index.html / main.js。プロジェクトが同じ名前のファイルを wwwroot に持たないときだけ配る。
                ファイルごとに判定するので、片方だけ差し替えることもできる。
            -->
            <_PrometeAssetCandidate
                Include="$(_PrometeWebRoot)/defaults/index.html"
                Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/index.html')"
            >
                <RelativePath>index.html</RelativePath>
                <ContentRoot>$(_PrometeWebRoot)/defaults/</ContentRoot>
            </_PrometeAssetCandidate>
            <_PrometeAssetCandidate
                Include="$(_PrometeWebRoot)/defaults/main.js"
                Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/main.js')"
            >
                <RelativePath>main.js</RelativePath>
                <ContentRoot>$(_PrometeWebRoot)/defaults/</ContentRoot>
            </_PrometeAssetCandidate>
        </ItemGroup>

        <DefineStaticWebAssets
            CandidateAssets="@(_PrometeAssetCandidate)"
            SourceId="$(PackageId)"
            SourceType="Computed"
            BasePath="$(StaticWebAssetBasePath)"
            AssetKind="All"
            AssetMode="All"
            AssetRole="Primary"
        >
            <Output TaskParameter="Assets" ItemName="_PrometeStaticWebAsset" />
        </DefineStaticWebAssets>

        <DefineStaticWebAssetEndpoints
            CandidateAssets="@(_PrometeStaticWebAsset)"
            ExistingEndpoints="@(StaticWebAssetEndpoint)"
            ContentTypeMappings="@(StaticWebAssetContentTypeMapping)"
        >
            <Output TaskParameter="Endpoints" ItemName="_PrometeStaticWebAssetEndpoint" />
        </DefineStaticWebAssetEndpoints>

        <ItemGroup>
            <StaticWebAsset Include="@(_PrometeStaticWebAsset)" />
            <StaticWebAssetEndpoint Include="@(_PrometeStaticWebAssetEndpoint)" />
        </ItemGroup>
    </Target>

    <!--
        参照先の実行プロジェクト (デスクトップの Promete.Example など) から伝播してきた、Promete のマニフェストとパッケージを
        出力と publish から外す。Web のアセットは PrometeAssetFile が届けるので、デスクトップ側のファイルは要らない。
        伝播の途中でカスタムのメタデータは落ちるので、名前の末尾で見分ける。ただし、このプロジェクトのフォルダの中のファイルは
        利用者自身の .prmtpak かもしれないので外さない。publish の一覧は出力の一覧から作られるので、ここで両方を外せる。
    -->
    <Target Name="_PrometeRemovePropagatedAssets" AfterTargets="GetCopyToOutputDirectoryItems">
        <!--
            候補の判定は metadata で行う (Condition の中で %() を property 関数に入れられないため)。
            _PrometeIsAssetFile: 名前が Promete のマニフェストかパッケージ。_PrometeIsLocal: このプロジェクトのフォルダの中にある。
        -->
        <ItemGroup>
            <_PrometeAssetCopyCandidate Include="@(_SourceItemsToCopyToOutputDirectory)">
                <_PrometeIsAssetFile>$([System.Text.RegularExpressions.Regex]::IsMatch('%(TargetPath)', '\.(prmtpak|promete-assets\.json)$'))</_PrometeIsAssetFile>
                <_PrometeIsLocal>$([System.String]::Copy('%(FullPath)').StartsWith('$(MSBuildProjectDirectory)\'))</_PrometeIsLocal>
            </_PrometeAssetCopyCandidate>
            <_PrometeAssetCopyCandidate Include="@(_SourceItemsToCopyToOutputDirectoryAlways)">
                <_PrometeIsAssetFile>$([System.Text.RegularExpressions.Regex]::IsMatch('%(TargetPath)', '\.(prmtpak|promete-assets\.json)$'))</_PrometeIsAssetFile>
                <_PrometeIsLocal>$([System.String]::Copy('%(FullPath)').StartsWith('$(MSBuildProjectDirectory)\'))</_PrometeIsLocal>
            </_PrometeAssetCopyCandidate>
            <_PrometeAssetCopyCandidate Include="@(_SourceItemsToCopyToOutputDirectoryIfDifferent)">
                <_PrometeIsAssetFile>$([System.Text.RegularExpressions.Regex]::IsMatch('%(TargetPath)', '\.(prmtpak|promete-assets\.json)$'))</_PrometeIsAssetFile>
                <_PrometeIsLocal>$([System.String]::Copy('%(FullPath)').StartsWith('$(MSBuildProjectDirectory)\'))</_PrometeIsLocal>
            </_PrometeAssetCopyCandidate>
        </ItemGroup>

        <ItemGroup>
            <_PrometePropagatedAsset
                Include="@(_PrometeAssetCopyCandidate)"
                Condition="'%(_PrometeAssetCopyCandidate._PrometeIsAssetFile)' == 'true' and '%(_PrometeAssetCopyCandidate._PrometeIsLocal)' != 'true'"
            />
        </ItemGroup>

        <ItemGroup>
            <_SourceItemsToCopyToOutputDirectory Remove="@(_PrometePropagatedAsset)" />
            <_SourceItemsToCopyToOutputDirectoryAlways Remove="@(_PrometePropagatedAsset)" />
            <_SourceItemsToCopyToOutputDirectoryIfDifferent Remove="@(_PrometePropagatedAsset)" />
            <AllItemsFullPathWithTargetPath Remove="@(_PrometePropagatedAsset)" />
        </ItemGroup>
    </Target>
</Project>
